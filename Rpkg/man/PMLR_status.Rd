\name{PMLR_status}
\alias{PMLR_status}
\title{Inspect the Julia shared-library bundle}
\usage{PMLR_status()}
\description{Reports whether the compiled Julia bundle is present in the installed R package. It does not guarantee that the bundle can be loaded successfully.}
\value{A list with \code{bundle_present} and \code{bundle_path}.}
